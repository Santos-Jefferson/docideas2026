# --- DocInsights API ---
# Base URL of the DocInsights OCR/analysis service.
DOCINSIGHTS_BASE_URL=https://docinsightsapi.use.eks.mcap.sip.dev.cloud.synchronoss.net
# Which DocInsights endpoint to use for processing. "/all" returns OCR + summary + classification.
DOCINSIGHTS_ENDPOINT=/all
# Request timeout in milliseconds (DocInsights can take a while on large PDFs).
DOCINSIGHTS_TIMEOUT_MS=300000

# --- Storage ---
# Directory where the SQLite db and uploaded files live. Defaults to ./data
DATA_DIR=./data

# --- Email inbound webhook ---
# Shared secret required as ?token=... on the inbound email webhook so randoms
# can't POST documents into your app. Leave blank to disable the check (dev only).
INBOUND_EMAIL_TOKEN=change-me

# --- Limits ---
# Max upload size in megabytes.
MAX_UPLOAD_MB=25
